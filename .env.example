# Copy to .env. Bun loads it for commands run from this directory, including
# the workspace scripts they start. Worker variables for local development
# live in apps/api/.dev.vars; its example is apps/api/.dev.vars.example.

# Deploy credentials, an alternative to `bunx wrangler login`
# (docs/deploy.md).
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Password the seed gives every sample member (docs/development.md). Without it
# the seed generates one and prints it.
# SEED_PASSWORD=
