NODE_ENV=development

LIBSQL_URL=file:./data/gmcan.db
# required for sqld/Turso in production
# LIBSQL_AUTH_TOKEN=

# Public URLs. BACKEND_URL is required in production. FRONTEND_URL has a default.
# BACKEND_URL=http://localhost:3000
# FRONTEND_URL=http://localhost:4200

# Secrets. Generate real values with openssl rand -hex 32.
ASSET_SIGNING_SECRET=dev-only-signing-secret

# Password of the seeded development members. Unset: a random one is printed on first seed.
# SEED_PASSWORD=

# Resend. Replace the key with a real one to send mail.
# Development mail goes to the Resend sandbox.
RESEND_API_KEY=re_replace_with_your_key
INSTITUTIONAL_EMAIL=gmcan@example.com

# i18n
SUPPORTED_LOCALES=es,en
DEFAULT_LOCALE=es
