# Build output named by content hash: a changed file gets a new name, so a cached copy never goes stale.
/chunk-*
  Cache-Control: public, max-age=31536000, immutable
/main-*
  Cache-Control: public, max-age=31536000, immutable
/polyfills-*
  Cache-Control: public, max-age=31536000, immutable
/styles-*
  Cache-Control: public, max-age=31536000, immutable
/media/*
  Cache-Control: public, max-age=31536000, immutable
/en/chunk-*
  Cache-Control: public, max-age=31536000, immutable
/en/main-*
  Cache-Control: public, max-age=31536000, immutable
/en/polyfills-*
  Cache-Control: public, max-age=31536000, immutable
/en/styles-*
  Cache-Control: public, max-age=31536000, immutable
/en/media/*
  Cache-Control: public, max-age=31536000, immutable
