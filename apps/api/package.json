  "type": "module",
  "main": "worker.ts",
  "scripts": {
    "start": "wrangler dev --port 3000",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typegen": "wrangler types --strict-vars=false",
    "migrate": "wrangler d1 migrations apply gmcan --local",
    "migrate:remote": "wrangler d1 migrations apply gmcan --remote",
    "seed": "bun scripts/seed.ts",
    "seed:remote": "bun scripts/seed.ts --remote",
    "lint": "oxlint",
    "typecheck": "bun run typegen && tsc -p tsconfig.json --noEmit",
    "test": "bun test --timeout 60000",
    "check": "bun run lint && bun run typecheck",
    "format": "oxfmt --fix .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@gmcan/contracts": "workspace:*",
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.13",
    "kysely": "^0.29.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.150.0"
  }
}
