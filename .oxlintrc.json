{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": { "browser": true, "node": true, "es2022": true },
  "ignorePatterns": ["dist/**", "out-tsc/**"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "style": "off",
    "perf": "warn",
    "nursery": "off"
  },
  "rules": {
    "typescript/no-extraneous-class": ["warn", { "allowWithDecorator": true }]
  },
  "overrides": [
    {
      "files": ["apps/api/routes/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/db/*"],
                "allowTypeImports": true,
                "message": "Routes call services. Move the query into the service that owns the aggregate."
              }
            ]
          }
        ]
      }
    }
  ]
}
