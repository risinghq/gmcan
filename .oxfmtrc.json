{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "sortImports": { "newlinesBetween": true },
  "overrides": [
    {
      "files": ["**/*.md", "**/*.yml", "**/*.yaml", "**/*.json", "**/*.jsonc"],
      "options": { "printWidth": 80, "proseWrap": "always" }
    }
  ]
}
