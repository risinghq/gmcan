{
  "name": "gmcan-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" run start",
    "dev:frontend": "pnpm --filter tesis-front run start",
    "dev:backend": "pnpm --filter backend-gmcan run start",
    "build": "pnpm --filter \"./apps/*\" run build",
    "build:frontend": "pnpm --filter tesis-front run build",
    "build:backend": "pnpm --filter backend-gmcan run build",
    "test": "pnpm --filter \"./apps/*\" run test",
    "lint": "pnpm --filter \"./apps/*\" run lint"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
