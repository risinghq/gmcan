{
  "name": "gmcan-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --filter './apps/*' start",
    "dev:frontend": "bun --filter frontend start",
    "dev:backend": "bun --filter backend start",
    "build": "bun --filter './apps/*' build",
    "build:frontend": "bun --filter frontend build",
    "build:backend": "bun --filter backend build",
    "test": "bun --filter './apps/*' test",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0"
  },
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.3.11",
  "trustedDependencies": [
    "bcrypt"
  ]
}
