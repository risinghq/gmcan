{
  "name": "gmcan-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun --filter './apps/*' start",
    "dev:frontend": "bun --filter frontend start",
    "dev:backend": "bun --filter backend start",
    "build": "bun --filter './apps/*' build",
    "build:frontend": "bun --filter frontend build",
    "build:backend": "bun --filter backend build",
    "test": "bun --filter './apps/*' test",
    "lint": "oxlint .",
    "typecheck": "bun run --filter frontend typecheck && bun run --filter backend typecheck",
    "check:test": "bun run --filter frontend test:ci",
    "check": "bun run lint && bun run typecheck && bun run check:test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=20.19.0"
  },
  "packageManager": "bun@1.3.13",
  "trustedDependencies": [
    "bcrypt"
  ]
}
